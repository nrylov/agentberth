{
  "format_version": 1,
  "id": "read-file",
  "version": "1.0.0",
  "name": "read_file",
  "description": "Read up to 8000 characters of a UTF-8 workspace file.",
  "runtime": "python",
  "entrypoint": "handler.py:run",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string"
      }
    },
    "required": [
      "content"
    ],
    "additionalProperties": false
  },
  "limits": {
    "timeout_seconds": 10,
    "max_output_bytes": 32000
  }
}
